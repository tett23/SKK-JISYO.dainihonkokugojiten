{
  "tasks": {
    "fetch": "deno run --allow-net --allow-read --allow-write --allow-env src/main.ts fetch",
    "ocr": "deno run --allow-read --allow-write --allow-env --allow-run src/main.ts ocr",
    "work": "deno run --allow-read --allow-write --allow-env src/main.ts work",
    "extract": "deno run --allow-read --allow-write --allow-env src/main.ts extract",
    "all": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run src/main.ts all",
    "test": "deno test --allow-read --allow-write --allow-env"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "fmt": { "lineWidth": 100, "proseWrap": "preserve" }
}
